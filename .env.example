# Copy to .env.local (gitignored) and fill in.
# Setup: docs/supabase.md · shared project: docs/shared-backend.md
#
# The Supabase project is SHARED with First 100. Our tables live in the
# `saythiswith` schema, profiles in `platform`. Clients are schema-pinned —
# see src/lib/supabase/client.ts (browser) and server.ts (routes).

# --- Supabase: server-only. NEVER expose the secret key client-side. ---------
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Supabase: client-side ---------------------------------------------------
# The publishable key is browser-safe by design; RLS guards the data.
# Auth UI stays hidden while these are unset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google sign-in ----------------------------------------------------------
# Sign-in is Google-only via signInWithIdToken, NOT signInWithOAuth: the
# redirect flow can only use the one Google client on the shared project, which
# would show both apps the same consent screen. This is our own client id.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Analytics ---------------------------------------------------------------
# PostHog is env-gated: absent key = no tracking, no errors.
# GA4 is wired in the root layout and is production-only.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Site --------------------------------------------------------------------
# Absolute origin for metadata, share links and OG images.
NEXT_PUBLIC_SITE_URL=

# --- Phase 3: the portal (server-only) ---------------------------------------
# Generated portraits. Vercel injects this automatically once a Blob store is
# attached to the project; set it by hand only for local development.
BLOB_READ_WRITE_TOKEN=

# Image generation for portraits. fal is the MVP provider — a real HTTP API
# with a queue model, pay-as-you-go, no subscription floor.
FAL_KEY=

# The portal conversation and arc generation.
ANTHROPIC_API_KEY=
